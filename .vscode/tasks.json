{
    // VSCode Tasks配置 - 跨平台支持 (Windows/Mac/Linux)
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    "version": "2.0.0",

    // 输入选项：选择烧录方式
    "inputs": [
        {
            "id": "flashMethod",
            "type": "pickString",
            "description": "选择烧录方式",
            "options": [
                "dfu-util (USB DFU模式，推荐)",
                "openocd + dap-link (无线调试器)",
                "openocd + stlink",
                "jlink (仅Windows)"
            ],
            "default": "dfu-util (USB DFU模式，推荐)"
        }
    ],

    "tasks": [
        // ==================== 编译任务 ====================
        {
            "label": "build",
            "type": "shell",
            // Windows使用mingw32-make，Mac/Linux使用make
            "windows": {
                "command": "C:\\msys64\\mingw64\\bin\\mingw32-make.exe",
                "args": ["-j12"]
            },
            "linux": {
                "command": "make",
                "args": ["-j12"]
            },
            "osx": {
                "command": "make",
                "args": ["-j12"]
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },

        // ==================== 清理任务 ====================
        {
            "label": "clean",
            "type": "shell",
            "windows": {
                "command": "C:\\msys64\\mingw64\\bin\\mingw32-make.exe",
                "args": ["clean"]
            },
            "linux": {
                "command": "make",
                "args": ["clean"]
            },
            "osx": {
                "command": "make",
                "args": ["clean"]
            },
            "problemMatcher": []
        },

        // ==================== 重新编译 ====================
        {
            "label": "rebuild",
            "dependsOrder": "sequence",
            "dependsOn": ["clean", "build"],
            "problemMatcher": []
        },

        // ==================== 烧录任务 - DFU-Util ====================
        {
            "label": "flash: dfu-util",
            "type": "shell",
            "dependsOn": "build",
            "dependsOrder": "sequence",
            "windows": {
                "command": "C:\\msys64\\mingw64\\bin\\mingw32-make.exe",
                "args": ["flash_dfu"]
            },
            "linux": {
                "command": "make",
                "args": ["flash_dfu"]
            },
            "osx": {
                "command": "make",
                "args": ["flash_dfu"]
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },

        // ==================== 烧录任务 - DAP-Link ====================
        {
            "label": "flash: dap-link",
            "type": "shell",
            "dependsOn": "build",
            "dependsOrder": "sequence",
            "windows": {
                "command": "C:\\msys64\\mingw64\\bin\\mingw32-make.exe",
                "args": ["flash_dap"]
            },
            "linux": {
                "command": "make",
                "args": ["flash_dap"]
            },
            "osx": {
                "command": "make",
                "args": ["flash_dap"]
            },
            "problemMatcher": []
        },

        // ==================== 烧录任务 - ST-Link ====================
        {
            "label": "flash: stlink",
            "type": "shell",
            "dependsOn": "build",
            "dependsOrder": "sequence",
            "windows": {
                "command": "C:\\msys64\\mingw64\\bin\\mingw32-make.exe",
                "args": ["flash_stlink"]
            },
            "linux": {
                "command": "make",
                "args": ["flash_stlink"]
            },
            "osx": {
                "command": "make",
                "args": ["flash_stlink"]
            },
            "problemMatcher": []
        },

        // ==================== 烧录任务 - JLink ====================
        {
            "label": "flash: jlink",
            "type": "shell",
            "dependsOn": "build",
            "dependsOrder": "sequence",
            "windows": {
                "command": "C:\\msys64\\mingw64\\bin\\mingw32-make.exe",
                "args": ["flash_jlink"]
            },
            "linux": {
                "command": "make",
                "args": ["flash_jlink"]
            },
            "osx": {
                "command": "make",
                "args": ["flash_jlink"]
            },
            "problemMatcher": []
        },

        // ==================== 快速烧录（使用默认方式）====================
        {
            "label": "flash (default: dfu)",
            "type": "shell",
            "dependsOn": "build",
            "dependsOrder": "sequence",
            "windows": {
                "command": "C:\\msys64\\mingw64\\bin\\mingw32-make.exe",
                "args": ["flash"]
            },
            "linux": {
                "command": "make",
                "args": ["flash"]
            },
            "osx": {
                "command": "make",
                "args": ["flash"]
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },

        // ==================== RTT日志查看 ====================
        {
            "label": "log",
            "type": "shell",
            "command": "JlinkRTTClient",
            "args": [],
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            }
        },

        // ==================== 传统兼容任务 ====================
        // 保留旧的命名以兼容现有脚本
        {
            "label": "build task",
            "dependsOn": "build"
        },
        {
            "label": "download dap",
            "dependsOn": "flash: dap-link"
        },
        {
            "label": "download jlink",
            "dependsOn": "flash: jlink"
        }
    ]
}
