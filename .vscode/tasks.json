{
    // VSCode Tasks配置 - 跨平台支持 (Windows/Mac/Linux)
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    "version": "2.0.0",

    // 输入选项：选择烧录方式
    "inputs": [
        {
            "id": "robotType",
            "type": "pickString",
            "description": "选择机器人配置",
            "options": [
                "infantry",
                "hero",
                "sentry"
            ],
            "default": "infantry"
        },
        {
            "id": "flashMethod",
            "type": "pickString",
            "description": "选择烧录方式",
            "options": [
                "dfu-util (USB DFU模式，推荐)",
                "openocd + dap-link (无线调试器)",
                "openocd + stlink",
                "jlink (仅Windows)"
            ],
            "default": "dfu-util (USB DFU模式，推荐)"
        }
    ],

    "tasks": [
        // ==================== 编译任务 ====================
        {
            "label": "build",
            "type": "shell",
            // Windows使用mingw32-make，Mac/Linux使用make
            "windows": {
                "command": "C:\\msys64\\usr\\bin\\bash.exe",
                "args": ["-lc", "/mingw64/bin/mingw32-make -j12 ROBOT_TYPE=${input:robotType}"],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "CHERE_INVOKING": "1",
                        "MSYSTEM": "MINGW64"
                    }
                }
            },
            "linux": {
                "command": "make",
                "args": ["-j12", "ROBOT_TYPE=${input:robotType}"]
            },
            "osx": {
                "command": "make",
                "args": ["-j12", "ROBOT_TYPE=${input:robotType}"]
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },

        // ==================== 清理任务 ====================
        {
            "label": "clean",
            "type": "shell",
            "windows": {
                "command": "C:\\msys64\\usr\\bin\\bash.exe",
                "args": ["-lc", "/mingw64/bin/mingw32-make clean ROBOT_TYPE=${input:robotType}"],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "CHERE_INVOKING": "1",
                        "MSYSTEM": "MINGW64"
                    }
                }
            },
            "linux": {
                "command": "make",
                "args": ["clean", "ROBOT_TYPE=${input:robotType}"]
            },
            "osx": {
                "command": "make",
                "args": ["clean", "ROBOT_TYPE=${input:robotType}"]
            },
            "problemMatcher": []
        },

        // ==================== 重新编译 ====================
        {
            "label": "rebuild",
            "dependsOrder": "sequence",
            "dependsOn": ["clean", "build"],
            "problemMatcher": []
        },

        // ==================== 烧录任务 - DFU-Util ====================
        {
            "label": "flash: dfu-util",
            "type": "shell",
            "dependsOn": "build",
            "dependsOrder": "sequence",
            "windows": {
                "command": "C:\\msys64\\usr\\bin\\bash.exe",
                "args": ["-lc", "/mingw64/bin/mingw32-make flash_dfu ROBOT_TYPE=${input:robotType}"],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "CHERE_INVOKING": "1",
                        "MSYSTEM": "MINGW64"
                    }
                }
            },
            "linux": {
                "command": "make",
                "args": ["flash_dfu", "ROBOT_TYPE=${input:robotType}"]
            },
            "osx": {
                "command": "make",
                "args": ["flash_dfu", "ROBOT_TYPE=${input:robotType}"]
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },

        // ==================== 烧录任务 - DAP-Link ====================
        {
            "label": "flash: dap-link",
            "type": "shell",
            "dependsOn": "build",
            "dependsOrder": "sequence",
            "windows": {
                "command": "C:\\msys64\\usr\\bin\\bash.exe",
                "args": ["-lc", "/mingw64/bin/mingw32-make flash_dap ROBOT_TYPE=${input:robotType}"],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "CHERE_INVOKING": "1",
                        "MSYSTEM": "MINGW64"
                    }
                }
            },
            "linux": {
                "command": "make",
                "args": ["flash_dap", "ROBOT_TYPE=${input:robotType}"]
            },
            "osx": {
                "command": "make",
                "args": ["flash_dap", "ROBOT_TYPE=${input:robotType}"]
            },
            "problemMatcher": []
        },

        // ==================== 烧录任务 - ST-Link ====================
        {
            "label": "flash: stlink",
            "type": "shell",
            "dependsOn": "build",
            "dependsOrder": "sequence",
            "windows": {
                "command": "C:\\msys64\\usr\\bin\\bash.exe",
                "args": ["-lc", "/mingw64/bin/mingw32-make flash_stlink ROBOT_TYPE=${input:robotType}"],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "CHERE_INVOKING": "1",
                        "MSYSTEM": "MINGW64"
                    }
                }
            },
            "linux": {
                "command": "make",
                "args": ["flash_stlink", "ROBOT_TYPE=${input:robotType}"]
            },
            "osx": {
                "command": "make",
                "args": ["flash_stlink", "ROBOT_TYPE=${input:robotType}"]
            },
            "problemMatcher": []
        },

        // ==================== 烧录任务 - JLink ====================
        {
            "label": "flash: jlink",
            "type": "shell",
            "dependsOn": "build",
            "dependsOrder": "sequence",
            "windows": {
                "command": "C:\\msys64\\usr\\bin\\bash.exe",
                "args": ["-lc", "/mingw64/bin/mingw32-make flash_jlink ROBOT_TYPE=${input:robotType}"],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "CHERE_INVOKING": "1",
                        "MSYSTEM": "MINGW64"
                    }
                }
            },
            "linux": {
                "command": "make",
                "args": ["flash_jlink", "ROBOT_TYPE=${input:robotType}"]
            },
            "osx": {
                "command": "make",
                "args": ["flash_jlink", "ROBOT_TYPE=${input:robotType}"]
            },
            "problemMatcher": []
        },

        // ==================== 快速烧录（使用默认方式）====================
        {
            "label": "flash (default: dfu)",
            "type": "shell",
            "dependsOn": "build",
            "dependsOrder": "sequence",
            "windows": {
                "command": "C:\\msys64\\usr\\bin\\bash.exe",
                "args": ["-lc", "/mingw64/bin/mingw32-make flash ROBOT_TYPE=${input:robotType}"],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "CHERE_INVOKING": "1",
                        "MSYSTEM": "MINGW64"
                    }
                }
            },
            "linux": {
                "command": "make",
                "args": ["flash", "ROBOT_TYPE=${input:robotType}"]
            },
            "osx": {
                "command": "make",
                "args": ["flash", "ROBOT_TYPE=${input:robotType}"]
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },

        // ==================== RTT日志查看 ====================
        {
            "label": "log",
            "type": "shell",
            "command": "JlinkRTTClient",
            "args": [],
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            }
        }
    ]
}
